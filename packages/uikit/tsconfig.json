{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "paths": {
      "tg-mini-app-uikit": ["./src/index.ts"],
      "@tg-mini-app/telegram": ["../telegram/src/index.ts"],
      "@tg-mini-app/telegram/testing": ["../telegram/src/testing.ts"]
    }
  },
  "include": ["src", "test", "storybook", "vitest.config.ts"]
}
