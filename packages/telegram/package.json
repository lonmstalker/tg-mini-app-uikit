{
  "name": "@tg-mini-app/telegram",
  "version": "0.4.1",
  "description": "Typed React bridge for the Telegram Mini Apps WebApp API (Bot API 9.6) — provider, back-button queue, native buttons, storage, capabilities, sensors, layout/theme.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.ts"
      ],
      "bridge": [
        "./bridge/telegram-web-app.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./bridge": {
      "types": "./bridge/telegram-web-app.d.cts",
      "default": "./bridge/telegram-web-app.cjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./bridge/*"
  ],
  "files": [
    "dist",
    "bridge",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "keywords": [
    "telegram",
    "mini-app",
    "react",
    "webapp",
    "bot-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonmstalker/tg-mini-app-uikit.git",
    "directory": "packages/telegram"
  },
  "homepage": "https://github.com/lonmstalker/tg-mini-app-uikit#readme",
  "bugs": "https://github.com/lonmstalker/tg-mini-app-uikit/issues"
}
