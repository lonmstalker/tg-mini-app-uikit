{
  "name": "tg-mini-app-uikit-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:uikit": "npm run build -w tg-mini-app-uikit",
    "stories": "npm run stories -w tg-mini-app-uikit",
    "stories:build": "npm run stories:build -w tg-mini-app-uikit",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:dev": "node scripts/serve-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "site:dev": "npm run dev -w showcase",
    "site:build": "npm run build -w showcase -- --base /tg-mini-app-uikit/",
    "site:deploy": "node scripts/build-site.mjs",
    "test:e2e": "playwright test",
    "check:e2e-count": "node scripts/check-e2e-count.mjs",
    "test:unit": "npm run test -w tg-mini-app-uikit",
    "test:coverage": "npm run test:coverage -w tg-mini-app-uikit",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "check:package": "node scripts/check-package.mjs",
    "check:cycles": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "check:api": "node scripts/check-api-surface.mjs",
    "check:api:update": "node scripts/check-api-surface.mjs --update",
    "typecheck": "npm run typecheck -w @tg-mini-app/telegram && npm run typecheck -w tg-mini-app-uikit",
    "check:rules": "node scripts/component-rules/index.mjs",
    "check:stories": "node scripts/check-stories-coverage.mjs",
    "check:animatable": "node scripts/check-animatable-props.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.60.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "dependency-cruiser": "^17.4.3",
    "gifenc": "^1.0.3",
    "playwright": "1.60.0",
    "pngjs": "^7.0.0",
    "publint": "^0.3.21",
    "react-doctor": "^0.5.4",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.1"
  }
}
